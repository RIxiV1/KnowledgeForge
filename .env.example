# Copy this file to .env and adjust as needed.

# Ollama models (must be pulled locally: `ollama pull <model>`)
LLM_MODEL=llama3.1:8b
EMBEDDING_MODEL=mxbai-embed-large:latest

# Storage paths
CHROMA_PATH=chroma_db
DATABASE_PATH=chat_history.db

# Retrieval / chunking
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
MAX_CONTEXT_LENGTH=9000
# Model context window (tokens). Ollama defaults to 4096 on low-VRAM GPUs, which
# truncates retrieved context out of the prompt — keep this >= the context above.
LLM_NUM_CTX=8192
# Minimum semantic relevance (0-1) to answer; below this the app says it
# couldn't find the answer. Set to 0 to disable the gate.
RELEVANCE_THRESHOLD=0.15
# Maximum uploaded-file size in MB (rejected before parsing).
MAX_UPLOAD_MB=50
